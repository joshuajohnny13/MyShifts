}

function ManageView({ shifts, staff, userRole, db }) {
  const emptyShift = { date: '', startTime: '', endTime: '', location: '', role: '', worker: '', workerEmail: '' };
  const [newShift, setNewShift] = useState(emptyShift);
  const [editingId, setEditingId] = useState(null);
  const [confirmDeleteId, setConfirmDeleteId] = useState(null);
  
  const [newStaffName, setNewStaffName] = useState('');
  const [newStaffEmail, setNewStaffEmail] = useState('');
  const [confirmStaffId, setConfirmStaffId] = useState(null);
  const [editingStaffId, setEditingStaffId] = useState(null);
  const [editStaffData, setEditStaffData] = useState({ name: '', email: '' });

  const [calendarBase, setCalendarBase] = useState(new Date());
  const [error, setError] = useState('');
  
  if (userRole !== 'admin') return (
    <div className="p-12 text-center flex flex-col items-center justify-center">
        <ShieldAlert className="w-12 h-12 text-red-400 mb-4" />
        <h2 className="text-xl font-bold text-gray-800">Access Denied</h2>
        <p className="text-sm text-gray-500 mt-2">Only administrators can manage the schedule.</p>
        <p className="text-xs text-teal-600 font-bold mt-4">Use the Upgrade box in the header if you have the Admin Code.</p>
    </div>
  );

  const handleSaveShift = async () => {
    setError('');
    if(!newShift.date || !newShift.startTime || !newShift.endTime || !newShift.worker) {
      setError("Please fill out Date, Times, and Worker Name.");
      return;
    }
    try {
      if (editingId) {
          await updateDoc(doc(db, "shifts", editingId), newShift);
          setEditingId(null);
      } else {
          await addDoc(collection(db, "shifts"), newShift);
      }
      // Sticky Form: Keep worker, location, role. Clear dates.
      setNewShift({ ...newShift, date: '', startTime: '', endTime: '' });
    } catch(err) {
      setError(err.message);
    }
  };

  const handleEditShift = (shift) => {
      setNewShift(shift);
      setEditingId(shift.id);
      setConfirmDeleteId(null);
      window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const handleAddStaff = async () => {
      if(!newStaffName.trim() || !newStaffEmail.trim()) {
          setError("Staff name and email are required.");
          return;
      }
      try {
          await addDoc(collection(db, "staff"), { name: newStaffName.trim(), email: newStaffEmail.trim() });
          setNewStaffName('');
          setNewStaffEmail('');
          setError('');
      } catch(err) {
          setError("Failed to add staff: " + err.message);
      }
  };

  const handleSaveStaffEdit = async (id) => {
      if(!editStaffData.name.trim() || !editStaffData.email.trim()) return;
      try {
          await updateDoc(doc(db, "staff", id), { name: editStaffData.name.trim(), email: editStaffData.email.trim() });
          
          // Auto-cascade email updates to their shifts to prevent broken schedules
          const oldStaff = staff.find(s => s.id === id);
          if (oldStaff && oldStaff.email !== editStaffData.email) {
              const shiftsToUpdate = shifts.filter(s => s.workerEmail === oldStaff.email);
              shiftsToUpdate.forEach(async (shift) => {
                  await updateDoc(doc(db, "shifts", shift.id), {
                      workerName: editStaffData.name.trim(),
                      workerEmail: editStaffData.email.trim()
                  });
              });
          }
          setEditingStaffId(null);
      } catch(err) {
          setError("Failed to update staff: " + err.message);
      }
  };

  // --- Quick Pick Calendar Logic ---
  const getQuickPickDays = () => {
      const days = [];
      let d = new Date(calendarBase.getFullYear(), calendarBase.getMonth(), 1);
      d.setDate(d.getDate() - (d.getDay() === 0 ? 6 : d.getDay() - 1)); // start on Monday
      for(let i=0; i<35; i++) {
          days.push(new Date(d));
          d.setDate(d.getDate() + 1);
      }
      return days;
  };

  const hasShiftOnDate = (dateObj) => {
      if (!newShift.workerEmail && !newShift.worker) return false;
      const dateStr = formatLocalYYYYMMDD(dateObj);
      return shifts.some(s => s.date === dateStr && (s.workerEmail === newShift.workerEmail || s.worker === newShift.worker));
  };

  return (
    <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      
      {/* Forms Column */}
      <div className="lg:col-span-1 space-y-6">
          <div className={`bg-white p-5 rounded-xl border shadow-sm transition-all ${editingId ? 'ring-2 ring-teal-500' : ''}`}>
            <h2 className="text-sm font-black text-gray-800 mb-4 border-b pb-2 uppercase tracking-widest flex items-center justify-between">
                {editingId ? 'Edit Existing Shift' : 'Create New Shift'}
                {editingId && <button onClick={() => {setEditingId(null); setNewShift(emptyShift);}} className="text-xs text-gray-400 hover:text-red-500 font-normal bg-gray-100 px-2 py-1 rounded">Cancel Edit</button>}
            </h2>
            
            {error && <div className="bg-red-50 text-red-600 p-2 text-xs rounded mb-4 font-bold border border-red-100">{error}</div>}
            
            <div className="space-y-3">
              <div>
                <label className="block text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1 flex justify-between">Worker <button type="button" onClick={() => setNewShift(emptyShift)} className="text-[9px] hover:text-teal-600 underline">Clear Form</button></label>
                <select className="w-full p-2 border border-gray-200 rounded text-sm focus:ring-2 focus:ring-teal-500 outline-none font-bold text-teal-800" value={newShift.workerEmail || newShift.worker} onChange={e => {
                    const val = e.target.value;
                    if (val === 'All') {
                        setNewShift({...newShift, workerEmail: 'all', worker: 'All'});
                    } else {
                        const s = staff.find(st => st.email === val || st.name === val);
                        setNewShift({...newShift, workerEmail: s?.email || val, worker: s?.name || val});
                    }
                }}>
                  <option value="">-- Select Staff --</option>
                  <option value="All">All Staff (Everyone)</option>
                  {staff.map(s => <option key={s.id} value={s.email || s.name}>{s.name}</option>)}
                </select>
              </div>

              {/* QUICK PICK CALENDAR */}
              {newShift.worker && newShift.worker !== 'All' && (
                  <div className="bg-blue-50 border border-blue-100 rounded-lg p-3 my-2 shadow-inner">
                      <div className="flex justify-between items-center mb-2">
                          <button type="button" onClick={() => setCalendarBase(new Date(calendarBase.getFullYear(), calendarBase.getMonth()-1, 1))} className="text-blue-600 hover:text-blue-800 px-2"><ChevronLeft className="w-4 h-4" /></button>
                          <div className="text-xs font-bold text-blue-800 uppercase tracking-widest">{calendarBase.toLocaleDateString('en-GB', { month: 'short', year: 'numeric'})}</div>
                          <button type="button" onClick={() => setCalendarBase(new Date(calendarBase.getFullYear(), calendarBase.getMonth()+1, 1))} className="text-blue-600 hover:text-blue-800 px-2"><ChevronRight className="w-4 h-4" /></button>
                      </div>
                      <div className="grid grid-cols-7 gap-1 text-center">
                          {['M','T','W','T','F','S','S'].map((d,i)=><div key={i} className="text-[10px] font-bold text-blue-400">{d}</div>)}
                          {getQuickPickDays().map((d, i) => {
                              const dateStr = formatLocalYYYYMMDD(d);
                              const isSelected = newShift.date === dateStr;
                              const hasShift = hasShiftOnDate(d);
                              const isCurrentMonth = d.getMonth() === calendarBase.getMonth();
                              
                              return (
                                  <button 
                                      key={i} 
                                      type="button"
                                      onClick={() => setNewShift({...newShift, date: dateStr})}
                                      className={`w-full aspect-square flex flex-col items-center justify-center rounded text-xs font-bold relative transition-colors ${!isCurrentMonth ? 'text-gray-300' : ''} ${isSelected ? 'bg-blue-600 text-white shadow-md' : 'hover:bg-blue-100 text-gray-700 bg-white border border-blue-50'}`}
                                  >
                                      {d.getDate()}
                                      {hasShift && <div className={`w-1 h-1 rounded-full absolute bottom-1 ${isSelected ? 'bg-white' : 'bg-blue-500'}`}></div>}
                                  </button>
                              )
                          })}
                      </div>
                      <div className="text-center mt-2 text-[9px] text-blue-600 italic uppercase">Tap a day to auto-fill the date below.</div>
                  </div>
              )}

              <div>
                <label className="block text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Date</label>
                <input type="date" className="w-full p-2 border border-gray-200 rounded text-sm focus:ring-2 focus:ring-teal-500 outline-none" value={newShift.date} onChange={e => setNewShift({...newShift, date: e.target.value})} />
              </div>
              <div className="grid grid-cols-2 gap-2">
                <div>
                    <label className="block text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Start Time</label>
                    <input type="time" className="w-full p-2 border border-gray-200 rounded text-sm focus:ring-2 focus:ring-teal-500 outline-none" value={newShift.startTime} onChange={e => setNewShift({...newShift, startTime: e.target.value})} />
                </div>
                <div>
                    <label className="block text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">End Time</label>
                    <input type="time" className="w-full p-2 border border-gray-200 rounded text-sm focus:ring-2 focus:ring-teal-500 outline-none" value={newShift.endTime} onChange={e => setNewShift({...newShift, endTime: e.target.value})} />
                </div>
              </div>
              <div className="grid grid-cols-2 gap-2">
                  <div>
                    <label className="block text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Location Code</label>
                    <input type="text" placeholder="e.g. TNT" className="w-full p-2 border border-gray-200 rounded text-sm uppercase focus:ring-2 focus:ring-teal-500 outline-none" value={newShift.location} onChange={e => setNewShift({...newShift, location: e.target.value.toUpperCase()})} />
                  </div>
                  <div>
                    <label className="block text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Role / Dept</label>
                    <input type="text" placeholder="e.g. MPS" className="w-full p-2 border border-gray-200 rounded text-sm focus:ring-2 focus:ring-teal-500 outline-none" value={newShift.role} onChange={e => setNewShift({...newShift, role: e.target.value})} />
                  </div>
              </div>
            </div>
            
            <button onClick={handleSaveShift} className={`mt-5 w-full text-white p-3 rounded font-black uppercase tracking-widest shadow-md transition-all active:scale-95 ${editingId ? 'bg-orange-500 hover:bg-orange-600' : 'bg-teal-600 hover:bg-teal-700'}`}>
              {editingId ? 'Update Shift' : 'Publish Shift'}
            </button>
          </div>

          <div className="bg-gray-50 p-5 rounded-xl border border-gray-200 shadow-sm">
              <h2 className="text-sm font-black text-gray-800 mb-3 uppercase tracking-widest flex items-center gap-2"><UserPlus className="w-4 h-4"/> Staff Directory</h2>
              <div className="flex flex-col gap-2 mb-4">
                  <input type="text" placeholder="New employee name..." className="w-full p-2 border border-gray-300 rounded text-sm outline-none focus:border-teal-500" value={newStaffName} onChange={e => setNewStaffName(e.target.value)} />
                  <input type="email" placeholder="Employee email (login)..." className="w-full p-2 border border-gray-300 rounded text-sm outline-none focus:border-teal-500" value={newStaffEmail} onChange={e => setNewStaffEmail(e.target.value)} onKeyDown={(e) => e.key === 'Enter' && handleAddStaff()} />
                  <button onClick={handleAddStaff} className="bg-gray-800 text-white px-3 py-2 rounded text-xs font-bold hover:bg-black w-full shadow-sm">Add Staff</button>
              </div>
              <div className="flex flex-col gap-2">
                  {staff.map(s => (
