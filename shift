                        <div className="text-xl font-bold text-teal-700 mb-2">{shift.workerName || shift.worker || 'Open Shift'}</div>
                        <div className="text-4xl font-black text-gray-800 tracking-tighter flex items-center justify-center gap-2">
                            {shift.startTime} <span className="text-teal-400 text-2xl">→</span> {shift.endTime}
                        </div>
                        <div className="mt-3 inline-block bg-teal-50 text-teal-800 border border-teal-200 px-4 py-1.5 rounded-full font-black text-sm shadow-sm">
                            {hours.toFixed(2)} Hours
                        </div>
