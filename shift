    );
}

function RosterGrid({ shifts, baseDate, setBaseDate, userName, userEmail, onShiftClick }) {
  // Anchor strictly to June 8, 2026 for perfectly aligned 3-week cycles
  const getAnchorOffsetDays = (currentBase) => {
      const anchor = new Date('2026-06-08T00:00:00');
      const diffTime = currentBase.getTime() - anchor.getTime();
      const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
      const cycleOffset = diffDays % 21;
      return cycleOffset >= 0 ? cycleOffset : 21 + cycleOffset;
  };

  const cycleStart = new Date(baseDate);
  cycleStart.setDate(cycleStart.getDate() - getAnchorOffsetDays(baseDate));

  const calendarDays = Array.from({ length: 21 }).map((_, i) => {
      const d = new Date(cycleStart);
      d.setDate(d.getDate() + i);
      return d;
  });

  const weeks = [calendarDays.slice(0, 7), calendarDays.slice(7, 14), calendarDays.slice(14, 21)];
  const dayLabels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

  const getShiftForDay = (dateObj) => {
    const formattedDate = formatLocalYYYYMMDD(dateObj);
    return shifts.find(s => s.date === formattedDate && isShiftForUser(s, userEmail, userName));
  };

  const formatDate = (date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

  let totalCycleHours = 0;

  return (
    <div className="w-full bg-white sm:border rounded sm:shadow-sm overflow-hidden">
      <div className="p-2 sm:p-3 border-b flex justify-between items-center bg-gray-50">
        <button onClick={() => setBaseDate(new Date(baseDate.setDate(baseDate.getDate() - 21)))} className="p-1 sm:p-1.5 bg-white border rounded shadow-sm hover:bg-gray-100"><ChevronLeft className="w-4 h-4 sm:w-5 sm:h-5 text-gray-600" /></button>
        <div className="text-xs sm:text-sm font-bold text-gray-700">
          {formatDate(calendarDays[0])} - {formatDate(calendarDays[20])}
        </div>
        <button onClick={() => setBaseDate(new Date(baseDate.setDate(baseDate.getDate() + 21)))} className="p-1 sm:p-1.5 bg-white border rounded shadow-sm hover:bg-gray-100"><ChevronRight className="w-4 h-4 sm:w-5 sm:h-5 text-gray-600" /></button>
      </div>

      <div className="overflow-hidden sm:overflow-x-auto">
        <div className="w-full sm:min-w-[700px]">
          <div className="grid grid-cols-[25px_repeat(7,minmax(0,1fr))] sm:grid-cols-[40px_repeat(7,minmax(0,1fr))] bg-slate-500 text-white font-bold text-center text-[10px] sm:text-sm py-1 sm:py-1.5">
            <div></div>
            {dayLabels.map(day => <div key={day} className="truncate px-0.5">{day}</div>)}
          </div>
          {weeks.map((week, wIndex) => {
            const firstDay = new Date(week[0].getFullYear(), 0, 1);
            const daysToFirstDay = Math.floor((week[0] - firstDay) / (24 * 60 * 60 * 1000));
            const weekNum = Math.ceil((week[0].getDay() + 1 + daysToFirstDay) / 7);

            return (
              <div key={wIndex} className="grid grid-cols-[25px_repeat(7,minmax(0,1fr))] sm:grid-cols-[40px_repeat(7,minmax(0,1fr))] border-b border-gray-200">
                <div className="bg-gray-50 flex items-center justify-center text-gray-400 text-[9px] sm:text-xs font-bold border-r border-gray-200">{weekNum}</div>
                {week.map((day, dIndex) => {
                  const shift = getShiftForDay(day);
                  if (shift) totalCycleHours += calculateShiftHours(shift.startTime, shift.endTime);
                  const isWeekend = dIndex === 5 || dIndex === 6;
                  const isToday = new Date().toDateString() === day.toDateString();

                  return (
                    <div key={dIndex} onClick={() => shift && onShiftClick(shift)} className={`min-h-[70px] sm:min-h-[100px] border-r border-gray-200 flex flex-col ${shift ? 'bg-[#e0f2fe] cursor-pointer hover:bg-blue-100 transition-colors' : 'bg-white'} ${isToday ? 'ring-2 ring-teal-500 inset-0 relative z-10' : ''}`}>
                      <div className={`text-right p-0.5 sm:p-1 text-[10px] sm:text-sm ${isWeekend ? 'text-red-600 font-bold' : 'text-gray-500'}`}>{day.getDate()}</div>
                      {shift && (
                        <div className="flex-1 flex flex-col items-center justify-center p-0.5 sm:p-1 text-gray-900 pb-1 sm:pb-2 overflow-hidden">
                          <span className="font-extrabold text-[11px] sm:text-[15px] leading-none sm:leading-tight">{shift.startTime.replace(':','')}</span>
                          <span className="font-extrabold text-[11px] sm:text-[15px] leading-none sm:leading-tight mb-0.5 sm:mb-1">{shift.endTime.replace(':','')}</span>
                          <span className="text-[8px] sm:text-[10px] uppercase tracking-tighter sm:tracking-wider text-gray-600 truncate w-full text-center px-0.5">{shift.location}</span>
                          <span className="hidden sm:block text-[10px] leading-tight text-center px-1 text-gray-500 truncate w-full">{shift.role}</span>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            );
          })}
        </div>
      </div>
      <div className="p-2 sm:p-3 bg-teal-50 border-t text-right text-xs sm:text-base font-black text-teal-800">
        Cycle Total: {totalCycleHours.toFixed(2)} Hours
      </div>
    </div>
  );
}

function MonthView({ shifts, baseDate, setBaseDate, userName, userEmail, onShiftClick }) {
  const getDaysInMonth = () => {
    const year = baseDate.getFullYear();
    const month = baseDate.getMonth();
    const date = new Date(year, month, 1);
    const days = [];
    
    let startDay = date.getDay() === 0 ? 6 : date.getDay() - 1;
    for(let i = 0; i < startDay; i++) days.push(null);
    
    while (date.getMonth() === month) {
      days.push(new Date(date));
      date.setDate(date.getDate() + 1);
    }
    return days;
  };

  const days = getDaysInMonth();
  const dayLabels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

  const getShiftForDay = (dateObj) => {
    if(!dateObj) return null;
    const formattedDate = formatLocalYYYYMMDD(dateObj);
    return shifts.find(s => s.date === formattedDate && isShiftForUser(s, userEmail, userName));
  };

  const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  
  let totalMonthHours = 0;

  return (
    <div className="w-full bg-white sm:border rounded sm:shadow-sm overflow-hidden">
      <div className="p-2 sm:p-3 border-b flex justify-between items-center bg-gray-50">
        <button onClick={() => setBaseDate(new Date(baseDate.getFullYear(), baseDate.getMonth() - 1, 1))} className="p-1 sm:p-1.5 bg-white border rounded shadow-sm hover:bg-gray-100"><ChevronLeft className="w-4 h-4 sm:w-5 sm:h-5 text-gray-600" /></button>
        <div className="text-xs sm:text-sm font-bold text-gray-700 uppercase tracking-widest text-center">
          <div>{monthNames[baseDate.getMonth()]} {baseDate.getFullYear()}</div>
        </div>
        <button onClick={() => setBaseDate(new Date(baseDate.getFullYear(), baseDate.getMonth() + 1, 1))} className="p-1 sm:p-1.5 bg-white border rounded shadow-sm hover:bg-gray-100"><ChevronRight className="w-4 h-4 sm:w-5 sm:h-5 text-gray-600" /></button>
      </div>

      <div className="grid grid-cols-7 bg-slate-500 text-white font-bold text-center text-[10px] sm:text-sm py-1 sm:py-1.5">
         {dayLabels.map(day => <div key={day} className="truncate px-0.5">{day}</div>)}
      </div>
      <div className="grid grid-cols-7 border-l border-gray-200">
         {days.map((day, index) => {
            const shift = getShiftForDay(day);
            if (shift) totalMonthHours += calculateShiftHours(shift.startTime, shift.endTime);
            const isWeekend = index % 7 === 5 || index % 7 === 6;
            
            if(!day) return <div key={`empty-${index}`} className="min-h-[50px] sm:min-h-[80px] border-r border-b border-gray-100 bg-gray-50"></div>;

            return (
                <div key={index} onClick={() => shift && onShiftClick(shift)} className={`min-h-[50px] sm:min-h-[80px] border-r border-b border-gray-200 flex flex-col p-0.5 sm:p-1 ${shift ? 'bg-[#e0f2fe] cursor-pointer hover:bg-blue-100 transition-colors' : 'bg-white'}`}>
                   <div className={`text-right text-[10px] sm:text-xs ${isWeekend ? 'text-red-500 font-bold' : 'text-gray-500'}`}>{day.getDate()}</div>
                   {shift && (
                       <div className="mt-auto sm:mt-1 text-center flex flex-col items-center w-full overflow-hidden">
                           <div className="text-[9px] sm:text-xs font-bold text-teal-800 bg-teal-100/50 sm:px-1 rounded w-full truncate leading-tight">
                               <span className="sm:hidden">{shift.startTime.split(':')[0]}-{shift.endTime.split(':')[0]}</span>
                               <span className="hidden sm:inline">{shift.startTime}-{shift.endTime}</span>
                           </div>
                           <div className="hidden sm:block text-[9px] text-gray-500 font-bold truncate w-full mt-0.5">{shift.location}</div>
                       </div>
                   )}
                </div>
            )
         })}
      </div>
      <div className="p-2 sm:p-3 bg-teal-50 border-t text-right text-xs sm:text-base font-black text-teal-800">
        Monthly Total: {totalMonthHours.toFixed(2)} Hours
      </div>
    </div>
  );
}

function DayView({ shifts, onShiftClick }) {
  const [selectedDate, setSelectedDate] = useState(formatLocalYYYYMMDD(new Date()));

  const dayShifts = shifts
    .filter(s => s.date === selectedDate)
    .sort((a, b) => (a.startTime || '').localeCompare(b.startTime || ''));

  const dateObj = parseLocalYYYYMMDD(selectedDate);
  const formattedDate = dateObj.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

  const handlePrevDay = () => {
    const prev = new Date(dateObj);
    prev.setDate(prev.getDate() - 1);
    setSelectedDate(formatLocalYYYYMMDD(prev));
  };

  const handleNextDay = () => {
    const next = new Date(dateObj);
    next.setDate(next.getDate() + 1);
    setSelectedDate(formatLocalYYYYMMDD(next));
  };

  return (
    <div className="bg-white border rounded shadow-sm overflow-hidden">
       <div className="bg-gray-50 p-3 border-b flex flex-col sm:flex-row sm:items-center justify-between gap-4">
         <div className="flex items-center gap-2">
            <button onClick={handlePrevDay} className="p-1.5 bg-white border rounded shadow-sm hover:bg-gray-100"><ChevronLeft className="w-5 h-5 text-gray-600" /></button>
            <h3 className="font-black text-gray-800 uppercase tracking-widest text-sm min-w-[200px] text-center">{formattedDate}</h3>
            <button onClick={handleNextDay} className="p-1.5 bg-white border rounded shadow-sm hover:bg-gray-100"><ChevronRight className="w-5 h-5 text-gray-600" /></button>
         </div>
         <input type="date" value={selectedDate} onChange={e => setSelectedDate(e.target.value)} className="p-2 border border-gray-300 rounded text-sm font-bold text-gray-700 outline-none focus:border-teal-500" />
       </div>
       <div className="divide-y divide-gray-100">
          {dayShifts.length === 0 ? (
             <div className="p-12 text-center text-gray-400 font-medium bg-white">No shifts scheduled for this day.</div>
          ) : (
             dayShifts.map((shift, idx) => (
                <div key={shift.id || idx} onClick={() => onShiftClick(shift)} className="p-4 flex flex-col sm:flex-row sm:items-center justify-between hover:bg-blue-50 cursor-pointer transition-colors">
                   <div className="flex items-center gap-4">
                      <div className="bg-teal-50 border border-teal-100 text-teal-800 rounded p-2 text-center shadow-sm min-w-[80px]">
                         <div className="font-black text-lg leading-none">{shift.startTime}</div>
                         <div className="text-[10px] font-bold text-gray-500 mt-1">TO {shift.endTime}</div>
                      </div>
                      <div>
                         <div className="font-black text-lg text-gray-800">{shift.worker}</div>
                         <div className="text-sm text-gray-500 flex items-center gap-2 mt-0.5">
                            <span className="font-bold text-teal-700">{shift.location}</span> • {shift.role}
                         </div>
                      </div>
                   </div>
                </div>
             ))
          )}
       </div>
    </div>
  );
}

function ShiftListView({ shifts, staff, baseDate, setBaseDate, onShiftClick }) {
  // Anchor strictly to June 8, 2026 for perfectly aligned 3-week cycles
  const getAnchorOffsetDays = (currentBase) => {
      const anchor = new Date('2026-06-08T00:00:00');
      const diffTime = currentBase.getTime() - anchor.getTime();
      const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
      const cycleOffset = diffDays % 21;
      return cycleOffset >= 0 ? cycleOffset : 21 + cycleOffset;
  };

  const cycleStart = new Date(baseDate);
  cycleStart.setDate(cycleStart.getDate() - getAnchorOffsetDays(baseDate));

  const days = Array.from({ length: 21 }).map((_, i) => {
      const d = new Date(cycleStart);
      d.setDate(d.getDate() + i);
      return d;
  });

  const getShift = (workerName, workerEmail, dateObj) => {
      const dateStr = formatLocalYYYYMMDD(dateObj);
      return shifts.find(s => s.date === dateStr && (
          s.worker === 'All' || s.workerEmail === 'all' || 
          (s.workerEmail && s.workerEmail.toLowerCase() === workerEmail?.toLowerCase()) || 
          (s.worker && s.worker.toLowerCase() === workerName?.toLowerCase())
      ));
  };

  return (
    <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div className="flex justify-between items-center p-3 bg-gray-50 border-b">
            <button onClick={() => setBaseDate(new Date(baseDate.setDate(baseDate.getDate() - 21)))} className="p-1.5 bg-white border rounded shadow-sm hover:bg-gray-100"><ChevronLeft className="w-5 h-5 text-gray-600" /></button>
            <div className="font-black text-gray-800 text-sm tracking-widest uppercase">
                {days[0].toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })} - {days[20].toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
            </div>
            <button onClick={() => setBaseDate(new Date(baseDate.setDate(baseDate.getDate() + 21)))} className="p-1.5 bg-white border rounded shadow-sm hover:bg-gray-100"><ChevronRight className="w-5 h-5 text-gray-600" /></button>
        </div>
        
        <div className="overflow-x-auto">
            <table className="w-full text-sm text-left whitespace-nowrap border-collapse">
                <thead className="bg-slate-500 text-white uppercase text-[10px] font-black tracking-wider">
                    <tr>
                        <th className="px-4 py-2 border-r border-slate-600 sticky left-0 bg-slate-600 z-20 shadow-[2px_0_5px_rgba(0,0,0,0.1)]">Staff</th>
                        {days.map((day, i) => (
                            <th key={i} className={`px-1 py-2 text-center border-r border-slate-600 min-w-[65px] ${day.getDay() === 0 || day.getDay() === 6 ? 'text-red-300' : ''}`}>
                                <div>{day.toLocaleDateString('en-GB', { weekday: 'short' })}</div>
                                <div className="text-xs mt-0.5">{day.getDate()}</div>
                            </th>
                        ))}
                        <th className="px-3 py-2 text-center border-l border-slate-600 sticky right-0 bg-slate-600 z-20 shadow-[-2px_0_5px_rgba(0,0,0,0.1)]">Total Hrs</th>
                    </tr>
                </thead>
                <tbody className="divide-y divide-gray-200">
                    {staff.sort((a,b) => a.name.localeCompare(b.name)).map(employee => {
                        let totalHours = 0;
                        return (
                            <tr key={employee.id} className="hover:bg-blue-50/50 group">
                                <td className="px-4 py-3 border-r font-bold text-gray-800 sticky left-0 bg-white group-hover:bg-blue-50 z-10 shadow-[2px_0_5px_rgba(0,0,0,0.02)]">
                                    {employee.name}
                                </td>
                                {days.map((day, i) => {
                                    const shift = getShift(employee.name, employee.email, day);
                                    if (shift) totalHours += calculateShiftHours(shift.startTime, shift.endTime);
                                    const isWeekend = day.getDay() === 0 || day.getDay() === 6;
                                    return (
                                        <td key={i} onClick={() => shift && onShiftClick(shift)} className={`p-1 border-r align-top ${shift ? 'cursor-pointer hover:bg-blue-100' : ''} ${isWeekend && !shift ? 'bg-gray-50' : ''}`}>
                                            {shift ? (
                                                <div className="bg-teal-50 text-teal-800 text-[10px] font-bold p-1 rounded border border-teal-200 h-full flex flex-col justify-center items-center shadow-sm min-h-[50px]">
                                                    <div className="leading-none">{shift.startTime.replace(':','')}</div>
                                                    <div className="leading-none mt-0.5 mb-1">{shift.endTime.replace(':','')}</div>
                                                    <div className="text-[8px] text-teal-600 uppercase tracking-wider truncate max-w-[55px]">{shift.location}</div>
                                                </div>
                                            ) : null}
                                        </td>
                                    );
                                })}
                                <td className="px-3 py-3 text-center font-black text-teal-700 bg-teal-50/50 border-l sticky right-0 z-10 group-hover:bg-teal-100/50">
                                    {totalHours > 0 ? totalHours.toFixed(2) : '-'}
                                </td>
                            </tr>
                        );
                    })}
                    {staff.length === 0 && (
                        <tr>
                            <td colSpan={23} className="p-8 text-center text-gray-400">No staff added yet.</td>
                        </tr>
                    )}
                </tbody>
            </table>
        </div>
    </div>
  );
}

