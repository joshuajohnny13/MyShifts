                                  </div>
                                  <div className="flex items-center gap-1 shrink-0">
                                      <button onClick={() => { setEditingStaffId(s.id); setEditStaffData({name: s.name, email: s.email || ''}); }} className="p-1.5 text-gray-400 hover:text-teal-600 bg-gray-50 rounded hover:bg-teal-50 transition-colors"><Edit2 className="w-3 h-3" /></button>
                                      {confirmStaffId === s.id ? (
                                         <div className="flex items-center gap-1 bg-red-50 rounded px-2 py-1 border border-red-100">
                                            <button onClick={() => deleteDoc(doc(db, "staff", s.id))} className="text-[10px] font-bold text-red-600 hover:underline">Yes</button>
                                            <span className="text-gray-300">|</span>
                                            <button onClick={() => setConfirmStaffId(null)} className="text-[10px] font-bold text-gray-500 hover:underline">No</button>
                                         </div>
                                      ) : (
                                         <button onClick={() => setConfirmStaffId(s.id)} className="p-1.5 text-gray-400 hover:text-red-500 bg-gray-50 rounded hover:bg-red-50 transition-colors"><Trash2 className="w-3 h-3" /></button>
                                      )}
                                  </div>
                              </div>
                          )}
                      </div>
                  ))}
                  {staff.length === 0 && <span className="text-xs text-gray-400 italic text-center p-2">No staff added.</span>}
              </div>
          </div>
      </div>

      {/* Database Column */}
      <div className="lg:col-span-2 bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden flex flex-col h-[600px]">
         <div className="bg-gray-50 p-4 border-b">
            <h3 className="font-black text-gray-800 uppercase tracking-widest">Active Shift Database</h3>
         </div>
         <div className="flex-1 overflow-y-auto p-4 space-y-3">
            {shifts.length === 0 ? <p className="text-sm text-gray-400 text-center py-10 font-medium">No shifts found in database.</p> : null}
            {shifts.sort((a,b) => parseLocalYYYYMMDD(b.date) - parseLocalYYYYMMDD(a.date)).map(s => (
                <div key={s.id} className={`flex flex-col sm:flex-row justify-between sm:items-center p-4 border rounded-lg transition-colors ${editingId === s.id ? 'bg-orange-50 border-orange-200' : 'hover:bg-gray-50 border-gray-100'}`}>
                    <div className="flex items-center gap-4 mb-3 sm:mb-0">
                        <div className="bg-gray-100 text-gray-600 font-bold px-3 py-2 rounded text-sm font-mono border w-28 text-center">{s.date}</div>
                        <div>
                            <div className="font-black text-teal-800 text-lg">{s.workerName || s.worker}</div>
                            <div className="text-xs text-gray-500 font-bold mt-0.5">
                                {s.startTime} - {s.endTime} <span className="mx-1">•</span> <span className="text-gray-800 uppercase">{s.location}</span>
                            </div>
                        </div>
                    </div>
                    <div className="flex gap-2 justify-end items-center">
                        <button onClick={() => handleEditShift(s)} className="flex items-center gap-1 bg-white border border-gray-200 text-gray-600 hover:text-teal-600 hover:border-teal-300 px-3 py-1.5 rounded text-xs font-bold transition-all shadow-sm">
                            <Edit2 className="w-3 h-3" /> Edit
                        </button>
                        
                        {confirmDeleteId === s.id ? (
                            <div className="flex items-center gap-2 bg-red-50 border border-red-100 rounded px-2 py-1 shadow-sm">
                                <span className="text-[10px] font-bold text-red-600 uppercase">Delete?</span>
                                <button onClick={() => deleteDoc(doc(db, "shifts", s.id))} className="text-xs font-bold text-red-700 hover:underline">Yes</button>
                                <span className="text-gray-300">|</span>
                                <button onClick={() => setConfirmDeleteId(null)} className="text-xs font-bold text-gray-500 hover:underline">No</button>
                            </div>
                        ) : (
                            <button onClick={() => setConfirmDeleteId(s.id)} className="flex items-center gap-1 bg-white border border-red-100 text-red-500 hover:bg-red-50 px-3 py-1.5 rounded text-xs font-bold transition-all shadow-sm">
                                <Trash2 className="w-3 h-3" />
                            </button>
                        )}
                    </div>
                </div>
            ))}
         </div>
      </div>
    </div>
  );
}

function AuthScreen() {
  const [isLogin, setIsLogin] = useState(true);
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [name, setName] = useState('');
  const [role, setRole] = useState('employee');
  const [adminCode, setAdminCode] = useState('');
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);

  const handleAuth = async (e) => {
    e.preventDefault();
    setError('');
    setLoading(true);

    try {
      if (isLogin) {
        await signInWithEmailAndPassword(auth, email, password);
      } else {
        if (role === 'admin' && adminCode !== 'ADMIN2026') {
          throw new Error("Invalid Admin Passcode.");
        }
        if (!name) throw new Error("Full Name is required.");
        
        const cred = await createUserWithEmailAndPassword(auth, email, password);
        await setDoc(doc(db, "users", cred.user.uid), {
          name, email, role
        });
      }
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8 font-sans">
      <div className="sm:mx-auto sm:w-full sm:max-w-md">
        <div className="flex justify-center text-teal-600 mb-2">
            <CalIcon className="w-12 h-12" />
        </div>
        <h2 className="text-center text-3xl font-extrabold text-gray-900">MyShifts</h2>
        <p className="mt-2 text-center text-sm text-gray-600">
          Sign in to access your schedule
        </p>
      </div>

      <div className="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div className="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 border border-gray-100">
          {error && <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4 text-sm font-bold">{error}</div>}
          
          <form className="space-y-6" onSubmit={handleAuth}>
            <div>
              <label className="block text-xs font-bold text-gray-500 uppercase tracking-widest">Email</label>
              <div className="mt-1">
                <input type="email" required className="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-teal-500 focus:border-teal-500 font-medium" value={email} onChange={e => setEmail(e.target.value)} />
              </div>
            </div>

            <div>
              <label className="block text-xs font-bold text-gray-500 uppercase tracking-widest">Password</label>
              <div className="mt-1">
                <input type="password" required className="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-teal-500 focus:border-teal-500 font-medium" value={password} onChange={e => setPassword(e.target.value)} />
              </div>
            </div>

            {!isLogin && (
              <div className="space-y-4 bg-gray-50 p-4 border rounded-md">
                <div>
                  <label className="block text-xs font-bold text-gray-500 uppercase tracking-widest">Full Name</label>
                  <p className="text-[10px] text-gray-400 mb-1">This must match the name the Admin uses for your shifts.</p>
                  <input type="text" required={!isLogin} className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-teal-500 focus:border-teal-500 font-medium" value={name} onChange={e => setName(e.target.value)} />
                </div>
                <div>
                  <label className="block text-xs font-bold text-gray-500 uppercase tracking-widest">Account Role</label>
                  <select className="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-teal-500 focus:border-teal-500 font-medium bg-white" value={role} onChange={e => setRole(e.target.value)}>
                    <option value="employee">Standard Employee</option>
                    <option value="admin">Administrator</option>
                  </select>
                </div>
                {role === 'admin' && (
                  <div className="bg-red-50 p-3 rounded border border-red-200">
                    <label className="block text-xs font-bold text-red-700 uppercase tracking-widest">Admin Passcode</label>
                    <input type="password" placeholder="Enter secret code" required={role === 'admin'} className="mt-1 block w-full px-3 py-2 border border-red-300 rounded-md focus:outline-none focus:ring-red-500 focus:border-red-500 font-mono" value={adminCode} onChange={e => setAdminCode(e.target.value)} />
                  </div>
                )}
              </div>
            )}

            <div>
              <button type="submit" disabled={loading} className="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-md text-sm font-bold uppercase tracking-widest text-white bg-teal-600 hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500 disabled:opacity-50 transition-colors">
                {loading ? 'Processing...' : (isLogin ? 'Sign In' : 'Create Account')}
              </button>
            </div>
          </form>

          <div className="mt-6 text-center">
             <button onClick={() => setIsLogin(!isLogin)} type="button" className="text-sm font-bold text-teal-600 hover:text-teal-500 transition-colors">
               {isLogin ? "Need an account? Sign up" : "Already registered? Sign in"}
             </button>
          </div>
        </div>
      </div>
    </div>
  );
}
